{
  "name": "ygo-tools-for-dsh",
  "version": "1.3.0",
  "description": "Native DeepSeek Harness tools for Yu-Gi-Oh card research, deck analysis, verified duel simulation, replay analysis, and YGOPro2 bridging.",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./presets/ygo.patch.yml": "./presets/ygo.patch.yml"
  },
  "files": [
    "lib",
    "skill",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "presets",
    "docs"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "yugioh",
    "ygopro",
    "game-ai",
    "dsh",
    "deepseek-harness",
    "cordis",
    "ocgcore"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./presets/ygo.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2"
  }
}
