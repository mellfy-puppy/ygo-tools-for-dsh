{
  "name": "ygopro-cdb-encode",
  "version": "1.1.1",
  "description": "YGOPro CDB encoder/decoder and query helpers for Node.js/TypeScript.",
  "keywords": [],
  "homepage": "https://github.com/purerosefallen/ygopro-cdb-encode",
  "bugs": {
    "url": "https://github.com/purerosefallen/ygopro-cdb-encode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purerosefallen/ygopro-cdb-encode.git"
  },
  "license": "MIT",
  "author": "Nanahira <nanahira@momobako.com>",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node build.js",
    "build:cjs": "node build.js cjs",
    "build:esm": "node build.js esm",
    "build:types": "node build.js types",
    "clean": "node build.js clean",
    "lint": "eslint --fix .",
    "start": "node dist/index.cjs",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "tests",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "dependencies": {
    "@types/sql.js": "^1.4.9",
    "nfkit": "^1.0.21",
    "sql.js": "^1.13.0",
    "ygopro-msg-encode": "^1.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "esbuild": "^0.27.3",
    "esbuild-register": "^3.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
