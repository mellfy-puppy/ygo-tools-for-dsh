{
  "name": "ygopro-deck-encode",
  "description": "YGOPro Deck encode and decode, with well-browser support.",
  "version": "1.0.16",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./legacy": {
      "require": "./legacy.js",
      "default": "./legacy.js",
      "types": "./legacy.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint --fix .",
    "build": "node build.js",
    "build:cjs": "node build.js cjs",
    "build:legacy": "node build.js legacy",
    "build:esm": "node build.js esm",
    "build:types": "node build.js types",
    "clean": "node build.js clean",
    "test": "jest --passWithNoTests",
    "start": "node dist/index.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://code.moenext.com/mycard/ygopro-deck-encode.git"
  },
  "author": "Nanahira <nanahira@momobako.com>",
  "license": "MIT",
  "keywords": [],
  "bugs": {
    "url": "https://code.moenext.com/mycard/ygopro-deck-encode/issues"
  },
  "homepage": "https://code.moenext.com/mycard/ygopro-deck-encode",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "tests",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/node": "^18.13.0",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "esbuild": "^0.17.7",
    "esbuild-register": "^3.4.2",
    "eslint": "8.22.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.4.2",
    "prettier": "^2.8.4",
    "rimraf": "^4.1.2",
    "ts-jest": "^29.0.5",
    "typescript": "^4.9.5",
    "ydke": "^1.1.0"
  }
}
