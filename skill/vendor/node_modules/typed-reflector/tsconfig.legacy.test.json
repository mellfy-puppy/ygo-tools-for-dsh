{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "sourceMap": true,
    "types": ["jest", "node"]
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "tests/reflect.spec.ts",
    "tests/reflect.legacy.spec.ts"
  ],
  "exclude": [
    "modern.ts",
    "src/modern.ts",
    "universal.ts",
    "src/universal.ts",
    "src/def-universal/**/*.ts",
    "tests/modern.spec.ts",
    "tests/universal.legacy.spec.ts",
    "tests/universal.modern.spec.ts"
  ]
}
