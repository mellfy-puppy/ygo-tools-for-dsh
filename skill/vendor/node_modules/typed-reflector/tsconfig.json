{
	"compilerOptions": {
		"outDir": "dist",
		"module": "commonjs",
		"target": "es2019",
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"declaration": true,
		"sourceMap": true
	},
	"compileOnSave": true,
	"allowJs": true,
	"include": [
		"*.ts",
		"src/**/*.ts"
	],
	"exclude": [
		"tests/**/*.ts",
		"modern.ts",
		"src/modern.ts",
		"universal.ts",
		"src/universal.ts",
		"src/def-universal/**/*.ts"
	]
}
