{
  "extends": "./tsconfig.universal.json",
  "compilerOptions": {
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["jest", "node"]
  },
  "include": [
    "universal.ts",
    "src/**/*.ts",
    "tests/universal.legacy.spec.ts"
  ],
  "exclude": [
    "tests/modern.spec.ts",
    "tests/reflect.spec.ts",
    "tests/reflect.legacy.spec.ts",
    "tests/universal.modern.spec.ts"
  ]
}
