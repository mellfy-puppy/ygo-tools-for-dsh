{
  "name": "typed-reflector",
  "version": "1.1.2",
  "description": "Metadata reflector with typing support.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.mjs",
      "require": "./dist/legacy.cjs"
    },
    "./modern": {
      "types": "./dist/modern.d.ts",
      "import": "./dist/modern.mjs",
      "require": "./dist/modern.cjs"
    },
    "./universal": {
      "types": "./dist/universal.d.ts",
      "import": "./dist/universal.mjs",
      "require": "./dist/universal.cjs"
    }
  },
  "scripts": {
    "lint": "eslint --fix .",
    "build": "node build.js",
    "build:cjs": "node build.js cjs",
    "build:esm": "node build.js esm",
    "build:types": "node build.js types",
    "clean": "node build.js clean",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "start": "node dist/index.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://code.moenext.com/3rdeye/typed-reflector.git"
  },
  "bugs": {
    "url": "https://code.moenext.com/3rdeye/typed-reflector/issues"
  },
  "homepage": "https://code.moenext.com/3rdeye/typed-reflector",
  "keywords": [
    "reflect",
    "reflector",
    "reflect-metadata"
  ],
  "author": "Nanahira <nanahira@momobako.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "esbuild": "^0.27.3",
    "esbuild-register": "^3.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
