{
  "compilerOptions": {
    "outDir": "dist",
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "esnext.decorators"],
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true
  },
  "compileOnSave": true,
  "allowJs": true,
  "include": [
    "modern.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "tests/**/*.ts"
  ]
}
